            font-size: 24px;
            color: var(--accent-gold);
            margin-bottom: 20px;
            border-left: 4px solid var(--accent-gold);
            padding-left: 15px;
        }
        .rating-summary {
            display: grid;
            grid-template-columns: 160px 1fr;
            gap: 30px;
            margin-bottom: 24px;
            align-items: center;
        }
        .rating-summary .big-score { text-align: center; }
        .rating-summary .big-score .num { font-size: 44px; font-weight: 800; color: var(--text-primary); font-family: var(--font-serif); }
        .rating-summary .big-score .stars { color: #facc15; font-size: 18px; margin: 4px 0; }
        .rating-summary .big-score .count { font-size: 13px; color: var(--text-sub); }
        .rating-bars .bar-row { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
        .rating-bars .bar-row span:first-child { font-size: 12px; color: var(--text-sub); width: 40px; }
        .rating-bars .bar-track { flex: 1; height: 8px; background: var(--bg-secondary); border-radius: 10px; overflow: hidden; }
        .rating-bars .bar-fill { height: 100%; background: var(--accent-gold); border-radius: 10px; }
        .rating-bars .bar-row span:last-child { font-size: 12px; color: var(--text-sub); width: 34px; text-align: right; }

        .review-list { border-top: 2px solid var(--border-color); padding-top: 16px; }
        .review-item { padding: 14px 0; border-bottom: 1px solid var(--border-color); }
        .review-item:last-child { border-bottom: none; }
        .review-item .reviewer { font-weight: 700; color: var(--text-primary); font-size: 15px; }
        .review-item .review-date { font-size: 12px; color: var(--text-sub); margin-left: 10px; }
        .review-item .review-stars { color: #facc15; font-size: 14px; margin: 4px 0; }
        .review-item .review-text { color: var(--text-sub); font-size: 14.5px; line-height: 1.6; }

        /* ============================================================
             📚 SIMILAR PRODUCTS
             ============================================================ */
        .similar-books h2 {
            font-family: var(--font-serif);
            font-size: 24px;
            color: var(--accent-gold);
            margin-bottom: 20px;
            border-left: 4px solid var(--accent-gold);
            padding-left: 15px;
        }
        .similar-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
            gap: 20px;
        }
        .similar-card {
            background: var(--bg-card);
            backdrop-filter: blur(8px);
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 14px;
            text-align: center;
            transition: all var(--transition);
            cursor: pointer;
        }
        .similar-card:hover { transform: translateY(-4px); border-color: var(--accent-gold); box-shadow: var(--shadow-hover); }
