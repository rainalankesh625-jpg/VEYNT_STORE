        .similar-card h4 { font-size: 13.5px; font-weight: 600; color: var(--text-primary); line-height: 1.3; min-height: 34px; }
        .similar-card .similar-price { font-size: 14px; font-weight: 700; color: var(--accent-gold); margin-top: 4px; }
        .similar-card .similar-original { font-size: 11px; color: var(--text-sub); text-decoration: line-through; opacity: 0.6; margin-left: 4px; }

        /* ============================================================
             📱 RESPONSIVE
             ============================================================ */
        @media (max-width: 900px) {
            .detail-grid { grid-template-columns: 1fr; }
            .preview-slider { max-width: 100%; }
            .rating-summary { grid-template-columns: 1fr; text-align: center; }
        }
        @media (max-width: 600px) {
            .main-container { padding: 80px 14px 30px; }
            .product-detail, .reviews-section { padding: 20px 16px; }
            .theme-toggle-btn, .back-btn { top: 14px; font-size: 18px; padding: 6px 10px; }
            .back-btn span.label { display: none; }
            .detail-price .current { font-size: 24px; }
            .btn-buy-lg { flex: 1; justify-content: center; padding: 13px 20px; font-size: 15px; }
            .similar-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
        }
    </style>
