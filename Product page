              }
          
        ];

        // ============================================================
        // 🧠 STATE
        // ============================================================
        let currentProduct = null;
        let slideIndex = 0;

        // ============================================================
        // 🔗 PICK PRODUCT FROM URL
        // ============================================================
        // Works with either: product.html?id=2  OR  product.html#2
        function getRequestedId() {
            const params = new URLSearchParams(window.location.search);
            if (params.get('id')) return parseInt(params.get('id'));
            const hash = window.location.hash.replace('#', '');
            if (hash) return parseInt(hash);
            return products[0].id;
        }

        function loadProduct(id) {
            const found = products.find(p => p.id === id) || products[0];
            currentProduct = found;
            slideIndex = 0;
            renderProduct();
            renderReviews();
            renderSimilar();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // ============================================================
        // 🎞️ SLIDESHOW HELPERS
        // ============================================================
        function goToSlide(i) {
            const imgs = currentProduct.previewImages;
            slideIndex = (i + imgs.length) % imgs.length;
            const track = document.getElementById('sliderTrack');
            if (track) track.style.transform = `translateX(-${slideIndex * 100}%)`;
            document.querySelectorAll('.slider-dots .dot').forEach((d, idx) => d.classList.toggle('active', idx === slideIndex));
        }
        function nextSlide() { goToSlide(slideIndex + 1); }
        function prevSlide() { goToSlide(slideIndex - 1); }

        // ============================================================
        // 🖥️ RENDER: PRODUCT DETAIL
        // ============================================================
        function renderProduct() {
            const p = currentProduct;
            const discount = Math.round((1 - p.price / p.originalPrice) * 100);
            const starsFull = Math.floor(p.rating);
            const stars = '★'.repeat(starsFull) + '☆'.repeat(5 - starsFull);

            document.getElementById('productRoot').innerHTML = `
                <div class="product-detail">
                    <div class="detail-grid">
                        <div>
                            <div class="preview-slider">
                                <div class="slider-track" id="sliderTrack">
                                    ${p.previewImages.map(img => `<img src="${img}" alt="${p.title} preview" />`).join('')}
                                </div>
                                ${p.previewImages.length > 1 ? `
                                    <button class="slider-arrow prev" onclick="prevSlide()"><i class="fas fa-chevron-left"></i></button>
                                    <button class="slider-arrow next" onclick="nextSlide()"><i class="fas fa-chevron-right"></i></button>
                                    <div class="slider-dots">
                                        ${p.previewImages.map((_, idx) => `<span class="dot ${idx === 0 ? 'active' : ''}" onclick="goToSlide(${idx})"></span>`).join('')}
                                    </div>
                                ` : ''}
                            </div>
                            <div class="preview-label">📖 Swipe or use the arrows to preview book pages</div>
                        </div>
                        <div class="detail-info">
                            <h1>${p.title}</h1>
                            <div class="detail-meta">
                                <span><i class="fas fa-tag"></i> ${p.category.toUpperCase()}</span>
                            </div>
                            <div class="detail-rating">
                                <span class="stars">${stars}</span>
                                <span class="rating-badge">${p.rating} / 5</span>
                                <span class="rating-count">${p.ratingCount} ratings</span>
                            </div>
                            <div class="detail-price">
                                <span class="current">$${p.price}</span>
                                <span class="original">$${p.originalPrice}</span>
                                <span class="discount">${discount}% off</span>
                            </div>
                            <div class="price-note">Inclusive of all taxes • Instant digital delivery</div>
                            <div class="detail-tags">${p.tags.map(t => `<span>${t}</span>`).join('')}</div>
                            <p class="detail-description">${p.desc}</p>
                            <div class="action-row">
                                <a href="${p.buyLink}" target="_blank" class="btn-buy-lg"><i class="fas fa-shopping-bag"></i> Buy Now</a>
                                <button class="btn-share-lg" onclick="shareProduct()" title="Share this book"><i class="fas fa-share-alt"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        // ============================================================
        // 🖥️ RENDER: REVIEWS
        // ============================================================
        function renderReviews() {
            const p = currentProduct;
            const total = Object.values(p.ratingBreakdown).reduce((a, b) => a + b, 0) || 1;
            const stars = '★'.repeat(Math.floor(p.rating)) + '☆'.repeat(5 - Math.floor(p.rating));

            const bars = [5, 4, 3, 2, 1].map(star => {
                const count = p.ratingBreakdown[star] || 0;
                const pct = Math.round((count / total) * 100);
                return `
                    <div class="bar-row">
                        <span>${star} ★</span>
                        <div class="bar-track"><div class="bar-fill" style="width:${pct}%"></div></div>
                        <span>${count}</span>
                    </div>
                `;
            }).join('');

            const reviewsHtml = p.reviews.length > 0 ? p.reviews.map(r => `
                <div class="review-item">
                    <span class="reviewer">${r.name}</span><span class="review-date">${r.date}</span>
                    <div class="review-stars">${'★'.repeat(r.stars)}${'☆'.repeat(5 - r.stars)}</div>
                    <div class="review-text">${r.text}</div>
                </div>
            `).join('') : `<div class="review-item"><div class="review-text">No reviews yet — be the first to review this book!</div></div>`;

            document.getElementById('reviewsRoot').innerHTML = `
                <h2>⭐ Ratings &amp; Reviews</h2>
                <div class="rating-summary">
                    <div class="big-score">
                        <div class="num">${p.rating}</div>
                        <div class="stars">${stars}</div>
                        <div class="count">${p.ratingCount} ratings</div>
                    </div>
                    <div class="rating-bars">${bars}</div>
                </div>
                <div class="review-list">${reviewsHtml}</div>
            `;
        }

        // ============================================================
        // 🖥️ RENDER: SIMILAR PRODUCTS (same category, excluding current)
        // ============================================================
        function renderSimilar() {
            const p = currentProduct;
            const similar = products.filter(b => b.id !== p.id && b.category === p.category).slice(0, 20);
            const grid = document.getElementById('similarGrid');

            if (similar.length === 0) {
                grid.innerHTML = `<div style="color:var(--text-sub);grid-column:1/-1;text-align:center;padding:20px;">No similar books yet.</div>`;
                return;
            }

            grid.innerHTML = similar.map(b => `
                <div class="similar-card" onclick="navigateToProduct(${b.id})">
                    <img src="${b.cover}" alt="${b.title}" loading="lazy" />
                    <h4>${b.title}</h4>
                    <div class="similar-price">$${b.price}<span class="similar-original">$${b.originalPrice}</span></div>
                </div>
            `).join('');
        }

        function navigateToProduct(id) {
            window.location.href = `PRODUCT DETAIL PAGE.html?id=${id}`;
        }

        // ============================================================
        // 📤 SHARE
        // ============================================================
        function shareProduct() {
            const p = currentProduct;
            const text = `📚 Check out "${p.title}" – an interactive digital book!`;
            const url = window.location.href;
            if (navigator.share) {
                navigator.share({ title: p.title, text: text, url: url }).catch(() => {});
            } else {
                navigator.clipboard.writeText(`${text}\n\n🔗 ${url}`).catch(() => {});
            }
        }

        // ============================================================
        // 🌙 THEME — AUTO-SYNCED WITH MAIN SITE
        // Same localStorage key ("veyntTheme") as the main store site.
        // 1) On load, this page picks up whatever theme the main site last set.
        // 2) It also listens for live changes (e.g. theme changed on the main
        //    site in another tab) and updates instantly, no reload needed.
        // 3) The toggle button here still works and updates the same shared key,
        //    so switching theme here also updates the main site's theme.
        // ============================================================
        const themeToggleBtn = document.getElementById('themeToggle');

        function applyTheme(theme) {
            if (theme === 'light') {
                document.documentElement.setAttribute('data-theme', 'light');
                themeToggleBtn.textContent = '☀️';
            } else {
                document.documentElement.setAttribute('data-theme', 'dark');
                themeToggleBtn.textContent = '🌙';
            }
        }

        applyTheme(localStorage.getItem('veyntTheme') || 'dark');

        themeToggleBtn.addEventListener('click', () => {
            const current = document.documentElement.getAttribute('data-theme');
            const next = current === 'dark' ? 'light' : 'dark';
            applyTheme(next);
            localStorage.setItem('veyntTheme', next);
        });

        // Live sync: fires when 'veyntTheme' changes in another tab/window
        // (e.g. the user toggles theme on the main VEYNT_BOOKS_STORE.html tab)
        window.addEventListener('storage', (e) => {
            if (e.key === 'veyntTheme' && e.newValue) {
                applyTheme(e.newValue);
            }
        });

        // ============================================================
        // 👆 SWIPE SUPPORT FOR SLIDESHOW (mobile)
        // ============================================================
        let touchStartX = 0;
        document.addEventListener('touchstart', (e) => {
            if (e.target.closest('.preview-slider')) touchStartX = e.changedTouches[0].screenX;
        });
        document.addEventListener('touchend', (e) => {
            if (!e.target.closest('.preview-slider')) return;
            const touchEndX = e.changedTouches[0].screenX;
            const diff = touchEndX - touchStartX;
            if (Math.abs(diff) > 40) {
                if (diff < 0) nextSlide(); else prevSlide();
            }
        });

        // ============================================================
        // 🔙 BACK BUTTON — EDIT "VEYNT_BOOKS_STORE.html" BELOW IF YOUR MAIN
        // FILE HAS A DIFFERENT NAME
        // ============================================================
        document.getElementById('backBtn').addEventListener('click', (e) => {
            if (document.referrer && document.referrer.includes(window.location.host)) {
                e.preventDefault();
                window.history.back();
            }
            // otherwise falls through to href="VEYNT_BOOKS_STORE.html"
        });

        // ============================================================
        // 🌐 ROUTING — react to hash/query changes without full reload
        // ============================================================
        window.addEventListener('hashchange', () => loadProduct(getRequestedId()));

        // ============================================================
        // 🚀 INIT
        // ============================================================
        loadProduct(getRequestedId());
    </script>
</body>
