        /* ===== DARK MODE (same key/values as main site) ===== */
        [data-theme="dark"] {
            --bg-primary: #1c1712;
            --bg-secondary: #2a231d;
            --bg-card: rgba(30, 25, 20, 0.90);
            --text-primary: #ece3d8;
            --text-dark: #f0e6d8;
            --text-light: #d4c8b8;
            --text-sub: #b0a090;
            --accent-gold: #c9a87c;
            --accent-gold-dark: #b8946a;
            --accent-gold-light: #d4c0a8;
            --border-color: #3d352c;
            --shadow: rgba(0, 0, 0, 0.3);
            --shadow-hover: rgba(0, 0, 0, 0.4);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: var(--font-sans);
            background-color: var(--bg-primary);
            background-image: var(--paper-texture);
            color: var(--text-dark);
            transition: background-color var(--transition), color var(--transition);
            min-height: 100vh;
        }
        body::before {
            content: '';
            position: fixed; top: 0; left: 0; right: 0; bottom: 0;
            background: radial-gradient(ellipse at 30% 20%, rgba(201, 168, 124, 0.06), transparent 60%),
                        radial-gradient(ellipse at 70% 80%, rgba(201, 168, 124, 0.04), transparent 50%);
            z-index: 0; pointer-events: none;
        }

        /* ============================================================
             🌙 THEME TOGGLE + BACK BUTTON (top bar, same style as main site)
             ============================================================ */
        .theme-toggle-btn, .back-btn {
            position: absolute; top: 20px; z-index: 10000;
            background: var(--bg-secondary);
            border: 2px solid var(--accent-gold);
            border-radius: 12px;
            color: var(--text-primary);
            font-size: 22px;
            padding: 8px 12px;
            cursor: pointer;
            transition: all var(--transition);
            box-shadow: 0 4px 20px var(--shadow);
            line-height: 1;
        }
        .back-btn { left: 20px; font-size: 16px; font-weight: 600; display: flex; align-items: center; gap: 8px; text-decoration: none; }
        .theme-toggle-btn { right: 20px; }
        .theme-toggle-btn:hover, .back-btn:hover {
            background: var(--accent-gold);
            color: var(--bg-primary);
            transform: scale(1.05);
        }

        .main-container {
            max-width: 1300px;
            margin: 0 auto;
            padding: 90px 20px 50px;
            position: relative;
            z-index: 1;
        }

        /* ============================================================
             📄 PRODUCT DETAIL GRID
             ============================================================ */
        .product-detail {
            background: var(--bg-card);
            backdrop-filter: blur(8px);
            border-radius: 20px;
            padding: 30px 32px;
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow);
            margin-bottom: 40px;
        }
        .detail-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
        }

        /* ============================================================
             🎞️ BOOK PREVIEW SLIDESHOW (Flipkart/Amazon style)
             ============================================================ */
        .preview-slider {
            position: relative;
            border-radius: 16px;
            overflow: hidden;
            border: 2px solid var(--border-color);
            background: var(--bg-secondary);
            aspect-ratio: 2/3;
            max-width: 420px;
        }
        .slider-track {
            display: flex;
            height: 100%;
            transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .slider-track img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            flex-shrink: 0;
        }
        .slider-arrow {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 40px; height: 40px;
            border-radius: 50%;
            border: 2px solid var(--accent-gold);
            background: var(--bg-card);
            color: var(--accent-gold);
            font-size: 16px;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            transition: all var(--transition);
            z-index: 5;
        }
        .slider-arrow:hover { background: var(--accent-gold); color: var(--bg-primary); }
        .slider-arrow.prev { left: 10px; }
        .slider-arrow.next { right: 10px; }
        .slider-dots {
            position: absolute;
            bottom: 12px; left: 0; right: 0;
            display: flex; justify-content: center; gap: 6px;
            z-index: 5;
        }
        .slider-dots .dot {
            width: 8px; height: 8px; border-radius: 50%;
            background: rgba(255,255,255,0.5);
            border: 1px solid var(--accent-gold);
            cursor: pointer;
            transition: all var(--transition);
        }
        .slider-dots .dot.active { background: var(--accent-gold); width: 20px; border-radius: 5px; }
        .preview-label {
            text-align: center;
            font-size: 12px;
            color: var(--text-sub);
            margin-top: 10px;
            letter-spacing: 0.5px;
        }

        /* ============================================================
             📘 PRODUCT INFO
             ============================================================ */
        .detail-info h1 {
            font-family: var(--font-serif);
            font-size: clamp(26px, 3vw, 34px);
            color: var(--text-primary);
            margin-bottom: 6px;
            line-height: 1.25;
        }
        .detail-meta { font-size: 14px; color: var(--text-sub); margin-bottom: 10px; }
        .detail-meta span { margin-right: 16px; }
        .detail-rating {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 14px;
        }
        .detail-rating .stars { color: #facc15; font-size: 18px; }
        .detail-rating .rating-badge {
            background: var(--accent-gold);
            color: var(--bg-primary);
            font-weight: 700;
            font-size: 13px;
            padding: 3px 10px;
            border-radius: 20px;
        }
        .detail-rating .rating-count { font-size: 13px; color: var(--text-sub); }

        .detail-price {
            display: flex;
            align-items: baseline;
            gap: 12px;
            margin: 6px 0 4px;
        }
        .detail-price .current { font-size: 30px; font-weight: 800; color: var(--accent-gold); }
        .detail-price .original { font-size: 18px; color: var(--text-sub); text-decoration: line-through; opacity: 0.65; }
        .detail-price .discount { font-size: 14px; font-weight: 700; color: #8b9a6b; }
        .price-note { font-size: 12px; color: var(--text-sub); margin-bottom: 16px; opacity: 0.8; }

        .detail-tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 4px 0 16px; }
        .detail-tags span {
            font-size: 12px;
            background: rgba(201, 168, 124, 0.12);
            color: var(--accent-gold);
            padding: 4px 14px;
            border-radius: 20px;
            border: 1px solid rgba(201, 168, 124, 0.15);
        }
        .detail-description { font-size: 15.5px; line-height: 1.8; color: var(--text-sub); margin-bottom: 20px; }

        .action-row { display: flex; gap: 12px; flex-wrap: wrap; }
        .btn-buy-lg {
            padding: 14px 42px;
            background: linear-gradient(135deg, var(--accent-gold), var(--accent-gold-dark));
            color: var(--bg-primary);
            font-weight: 700;
            font-size: 17px;
            border: none;
            border-radius: 60px;
            cursor: pointer;
            transition: all var(--transition);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }
        .btn-buy-lg:hover { transform: scale(1.03); box-shadow: 0 8px 30px rgba(201, 168, 124, 0.3); }
        .btn-share-lg {
