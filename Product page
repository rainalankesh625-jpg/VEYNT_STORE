            --text-dark: #1a1410;
            --text-light: #4a3f35;
            --text-sub: #6b5f53;
            --accent-gold: #c9a87c;
            --accent-gold-dark: #b8946a;
            --accent-gold-light: #e0ceb8;
            --border-color: #dcd0c2;
            --shadow: rgba(44, 36, 26, 0.10);
            --shadow-hover: rgba(44, 36, 26, 0.16);
            --font-serif: 'Georgia', 'Times New Roman', serif;
