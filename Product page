        }
        .btn-share-lg:hover { border-color: var(--accent-gold); color: var(--accent-gold); }

        /* ============================================================
             ⭐ RATINGS & REVIEWS
             ============================================================ */
        .reviews-section {
            background: var(--bg-card);
            backdrop-filter: blur(8px);
            border-radius: 20px;
            padding: 28px 30px;
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow);
